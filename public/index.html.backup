<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consearch - Live Concert Experience</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;500;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #000; color: white; overflow-x: hidden; transition: background-color 1.2s cubic-bezier(0.4, 0, 0.2, 1); }
        
        /* Ambient Background Effect */
        #ambient-bg {
            position: fixed; inset: 0; z-index: -1;
            background: radial-gradient(circle at 50% 30%, var(--bg-color, #5b21b6), #000 70%);
            opacity: 0.6; transition: all 1s ease;
        }

        /* Nav Icon Animation */
        .nav-icon { transition: transform 0.3s; }
        .nav-icon:hover { transform: scale(1.1); }

        /* Sidebar Transition */
        .sidebar { transform: translateX(-100%); transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .sidebar.open { transform: translateX(0); }

        /* Glassmorphism */
        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }
        
        /* Slider Styling */
        .slider-container { 
            display: flex; 
            overflow-x: scroll; 
            scroll-snap-type: x mandatory; 
            scroll-behavior: smooth; 
            gap: 1rem;
            padding: 2rem 0;
        }
        .slider-container::-webkit-scrollbar { display: none; }
        
        .slide-card { 
            flex: 0 0 50%;
            scroll-snap-align: center; 
            transform: scale(0.75) blur(4px);
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), 
                        opacity 0.6s ease, 
                        filter 0.6s ease;
            opacity: 0.4;
            filter: blur(8px) brightness(0.7);
        }
        
        .slide-card.active { 
            transform: scale(1) blur(0px);
            opacity: 1; 
            z-index: 10;
            filter: blur(0px) brightness(1);
        }
        
        @media (min-width: 768px) { 
            .slide-card { flex: 0 0 35%; } 
        }
        
        @media (min-width: 1024px) { 
            .slide-card { flex: 0 0 28%; } 
        }
    </style>
</head>
<body class="min-h-screen">

    <div id="ambient-bg"></div>

    <nav class="fixed w-full z-50 px-6 py-4 flex justify-between items-center bg-gradient-to-b from-black/90 to-transparent">
        
        <button onclick="toggleSidebar()" class="group z-50 relative">
            <div id="burger-icon" class="space-y-1.5 p-2 glass rounded-full hover:bg-white/20 transition">
                <span class="block w-6 h-0.5 bg-white transition group-hover:bg-gray-200"></span>
                <span class="block w-4 h-0.5 bg-white transition group-hover:w-6"></span>
                <span class="block w-6 h-0.5 bg-white transition group-hover:bg-gray-200"></span>
            </div>
        </button>

        <h1 class="text-2xl font-extrabold tracking-[0.2em] text-white/90 drop-shadow-lg">CONSEARCH</h1>

        <div class="flex items-center gap-4">
            <button onclick="toggleMyTickets()" class="nav-icon p-2 glass rounded-full relative">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                <span class="absolute top-0 right-0 w-2.5 h-2.5 bg-red-500 rounded-full border border-black"></span>
            </button>
            <button onclick="toggleUserMenu()" class="nav-icon w-9 h-9 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center font-bold text-xs border-2 border-white/20">
                U
            </button>
        </div>
    </nav>

    <div id="sidebar" class="sidebar fixed inset-y-0 left-0 w-80 bg-[#0f0f0f] z-40 flex flex-col pt-24 px-8 border-r border-white/10 shadow-2xl">
        <div class="space-y-6">
            <div class="flex items-center gap-4 text-white/50 text-sm font-bold uppercase tracking-widest mb-4">Menu</div>
            <a href="#" class="text-2xl font-bold hover:text-indigo-400 transition flex items-center gap-4">
                <span>👤</span> Account
            </a>
            <a href="#calendar-section" onclick="toggleSidebar()" class="text-2xl font-bold hover:text-indigo-400 transition flex items-center gap-4">
                <span>📅</span> Event Calendar
            </a>
            <div class="h-px bg-white/10 my-4"></div>
            
            <div class="flex items-center justify-between">
                <span class="text-lg font-medium text-gray-300">Language</span>
                <button onclick="toggleLang(this)" class="glass px-3 py-1 rounded-full text-xs font-bold text-white flex gap-2">
                    <span class="text-indigo-400">EN</span> <span class="text-gray-500">|</span> <span>ID</span>
                </button>
            </div>

            <a href="#" class="text-lg text-gray-400 hover:text-white mt-4">Help Center</a>
        </div>
        <div class="mt-auto mb-8 text-xs text-gray-600">
            Consearch (Cloud Exam Build)
        </div>
    </div>

    <div class="relative h-screen flex flex-col justify-center pt-10">
        <div id="slider" class="slider-container px-[50vw] md:px-[35vw] gap-4 md:gap-8 py-10">
            </div>

        <div class="absolute bottom-10 w-full text-center text-white/50 text-sm animate-pulse">
            ← Swipe Smooth dengan Blur Effect →
        </div>
    </div>

    <div id="calendar-section" class="bg-black relative z-10 py-16 px-6 border-t border-white/10">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-extrabold mb-8 flex items-center gap-3">
                <span class="text-indigo-500">#</span> Discover Local Gigs
            </h2>
            <div id="calendar-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                </div>
        </div>
    </div>

    <div id="detail-modal" class="fixed inset-0 z-[60] bg-black/95 hidden flex flex-col md:flex-row animate-fade-in">
        <div class="w-full md:w-1/2 h-64 md:h-full relative">
            <img id="modal-img" src="" class="w-full h-full object-cover opacity-80">
            <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
            <button onclick="closeModal()" class="absolute top-6 left-6 glass p-2 rounded-full text-white hover:bg-white/20 md:hidden">✕ Close</button>
        </div>
        
        <div class="w-full md:w-1/2 p-8 md:p-16 flex flex-col justify-center relative">
            <button onclick="closeModal()" class="absolute top-8 right-8 text-gray-400 hover:text-white hidden md:block text-xl">✕ Close</button>
            
            <span id="modal-cat" class="text-indigo-400 font-bold tracking-widest text-sm mb-2">CATEGORY</span>
            <h2 id="modal-title" class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">Event Title</h2>
            
            <div class="space-y-4 mb-8 text-gray-300">
                <p class="flex items-center gap-3"><span class="text-xl">📍</span> <span id="modal-loc">Location</span></p>
                <p class="flex items-center gap-3"><span class="text-xl">📅</span> <span id="modal-date">Date</span></p>
                <p class="flex items-center gap-3"><span class="text-xl">💰</span> <span id="modal-price" class="text-white font-bold text-xl">Price</span></p>
            </div>

            <div class="glass p-6 rounded-2xl border-l-4 border-indigo-500 mb-8">
                <div class="flex justify-between items-end">
                    <div>
                        <p class="text-xs text-gray-400 uppercase">Available Seats</p>
                        <p id="modal-stock" class="text-3xl font-bold text-white">0</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-green-400 animate-pulse">● Selling Fast</p>
                    </div>
                </div>
            </div>

            <button id="modal-btn" onclick="" class="w-full bg-white text-black font-extrabold py-4 rounded-xl hover:bg-indigo-400 hover:text-white transition transform active:scale-95 text-lg">
                SECURE YOUR TICKET
            </button>
        </div>
    </div>

    <div id="user-menu" class="fixed top-20 right-6 w-64 glass rounded-xl p-4 hidden z-50 animate-bounce-in">
        <ul class="space-y-2 text-sm text-gray-300">
            <li class="hover:bg-white/10 p-2 rounded cursor-pointer">🎫 My Tickets</li>
            <li class="hover:bg-white/10 p-2 rounded cursor-pointer">💳 Wallet</li>
            <li class="h-px bg-white/10 my-1"></li>
            <li class="hover:bg-white/10 p-2 rounded cursor-pointer">About Consearch</li>
            <li class="hover:bg-white/10 p-2 rounded cursor-pointer text-yellow-400">★ Give Rating</li>
            <li class="hover:bg-white/10 p-2 rounded cursor-pointer text-red-400 font-bold">Log Out</li>
        </ul>
    </div>

    <script>
        // --- GLOBAL VARIABLES ---
        let allEvents = [];
        let sliderContainer = document.getElementById('slider');

        // --- FETCH DATA ---
        async function init() {
            const res = await fetch('/api/events');
            allEvents = await res.json();
            
            renderSlider();
            renderCalendar();
            
            // Set initial color logic
            sliderContainer.addEventListener('scroll', updateActiveSlide);
            // Delay sedikit agar render selesai
            setTimeout(() => updateActiveSlide(), 500); 
        }

        // --- RENDER SLIDER UTAMA ---
        function renderSlider() {
            const majors = allEvents.filter(e => e.is_major);
            sliderContainer.innerHTML = ''; // Clear spacer
            
            // Add spacers for centering
            sliderContainer.innerHTML += `<div class="shrink-0 w-[5vw] md:w-[20vw]"></div>`;

            majors.forEach((evt, index) => {
                sliderContainer.innerHTML += `
                <div class="slide-card relative rounded-3xl overflow-hidden aspect-[3/4] shadow-2xl cursor-pointer group" 
                     data-color="${evt.theme_color}"
                     id="slide-${evt.id}"
                     onclick="openModal(${evt.id})">
                    <img src="${evt.image_url}" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
                    
                    <div class="absolute bottom-0 left-0 p-6 md:p-8 transform translate-y-4 group-hover:translate-y-0 transition">
                        <span class="bg-white/20 backdrop-blur px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest mb-2 inline-block">${evt.category}</span>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-none">${evt.name}</h2>
                        <p class="text-gray-300 mt-2 text-sm hidden md:block">${evt.location}</p>
                    </div>
                </div>`;
            });

            sliderContainer.innerHTML += `<div class="shrink-0 w-[5vw] md:w-[20vw]"></div>`;
        }

        // --- RENDER CALENDAR (UMKM) ---
        function renderCalendar() {
            const minors = allEvents.filter(e => !e.is_major);
            const grid = document.getElementById('calendar-grid');
            grid.innerHTML = '';
            
            minors.forEach(evt => {
                grid.innerHTML += `
                <div class="flex gap-4 items-center bg-white/5 p-4 rounded-xl hover:bg-white/10 transition cursor-pointer border border-white/5" onclick="alert('Indie Event Detail: ${evt.name}')">
                    <img src="${evt.image_url}" class="w-16 h-16 rounded-lg object-cover bg-gray-800">
                    <div>
                        <h4 class="font-bold text-white text-lg leading-tight">${evt.name}</h4>
                        <p class="text-xs text-gray-400 mt-1">📅 ${evt.date}</p>
                        <p class="text-xs text-indigo-400 mt-1 font-bold">${evt.price}</p>
                    </div>
                </div>`;
            });
        }

        // --- LOGIC GANTI WARNA BACKGROUND (DYNAMIC) ---
        function updateActiveSlide() {
            const center = sliderContainer.scrollLeft + (sliderContainer.offsetWidth / 2);
            const cards = document.querySelectorAll('.slide-card');
            
            let closest = null;
            let minDist = Infinity;

            cards.forEach(card => {
                const rect = card.getBoundingClientRect();
                const cardCenter = rect.left + (rect.width / 2);
                const dist = Math.abs(window.innerWidth / 2 - cardCenter); // Jarak ke tengah layar

                if (dist < minDist) {
                    minDist = dist;
                    closest = card;
                }
                
                // Visual effect scale dengan blur
                if (dist < 250) {
                    card.classList.add('active');
                    card.style.opacity = 1;
                    card.style.filter = 'blur(0px) brightness(1)';
                } else {
                    card.classList.remove('active');
                    card.style.opacity = 0.3;
                    card.style.filter = 'blur(10px) brightness(0.6)';
                }
            });

            // Ganti warna background
            if (closest) {
                const color = closest.getAttribute('data-color');
                document.getElementById('ambient-bg').style.setProperty('--bg-color', color);
            }
        }

        // --- MODAL & NAVIGATION LOGIC ---
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            const burger = document.getElementById('burger-icon');
            
            sb.classList.toggle('open');
            
            // Ubah Icon Burger <-> X
            if(sb.classList.contains('open')) {
                burger.innerHTML = `<span class="text-2xl font-bold text-white">✕</span>`;
            } else {
                burger.innerHTML = `
                <span class="block w-6 h-0.5 bg-white"></span>
                <span class="block w-4 h-0.5 bg-white"></span>
                <span class="block w-6 h-0.5 bg-white"></span>`;
            }
        }

        function toggleUserMenu() {
            document.getElementById('user-menu').classList.toggle('hidden');
        }

        function openModal(id) {
            const evt = allEvents.find(e => e.id === id);
            if(!evt) return;

            document.getElementById('modal-img').src = evt.image_url;
            document.getElementById('modal-title').innerText = evt.name;
            document.getElementById('modal-cat').innerText = evt.category;
            document.getElementById('modal-loc').innerText = evt.location;
            document.getElementById('modal-date').innerText = evt.date;
            document.getElementById('modal-price').innerText = evt.price;
            document.getElementById('modal-stock').innerText = evt.stock;
            document.getElementById('modal-btn').onclick = () => warTiket(id);

            document.getElementById('detail-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('detail-modal').classList.add('hidden');
        }

        async function warTiket(id) {
            try {
                const res = await fetch('/api/book/' + id, { method: 'POST' });
                const data = await res.json();
                if(res.ok) {
                    alert(`✅ SUCCESS!\nSisa Stok: ${data.sisa_stok}`);
                    document.getElementById('modal-stock').innerText = data.sisa_stok;
                    
                    // Update data global
                    const evt = allEvents.find(e => e.id === id);
                    if(evt) evt.stock = data.sisa_stok;
                } else {
                    alert(`❌ SOLD OUT!`);
                }
            } catch(e) { alert("Server Error!"); }
        }

        function toggleLang(btn) {
            // Visual toggle only for exam
            const spans = btn.querySelectorAll('span');
            spans[0].classList.toggle('text-indigo-400');
            spans[0].classList.toggle('text-gray-500');
            spans[2].classList.toggle('text-indigo-400');
            spans[2].classList.toggle('text-gray-500');
        }

        // Start
        // --- FITUR DRAG-TO-SCROLL (MOUSE) ---
        const slider = document.getElementById('slider');
        let isDown = false;
        let startX;
        let scrollLeft;

        slider.addEventListener('mousedown', (e) => {
            isDown = true;
            slider.classList.add('active'); // Opsional: untuk styling kursor
            slider.style.cursor = 'grabbing';
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
        });

        slider.addEventListener('mouseleave', () => {
            isDown = false;
            slider.style.cursor = 'grab';
        });

        slider.addEventListener('mouseup', () => {
            isDown = false;
            slider.style.cursor = 'grab';
            // Pemicu snap effect manual saat dilepas
            slider.style.scrollSnapType = 'x mandatory';
        });

        slider.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            slider.style.scrollSnapType = 'none'; // Matikan snap saat dragging biar smooth
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 1.5; // Kecepatan scroll smooth
            slider.scrollLeft = scrollLeft - walk;
            
            // Update slide effect saat drag
            updateActiveSlide();
        });
        
        // Set cursor awal
        slider.style.cursor = 'grab';
        init();
    </script>
</body>
</html>